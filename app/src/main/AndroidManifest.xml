<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 蓝牙（车机 BLE 连接） -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:targetApi="31" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 高德地图 / 搜索 / 定位 SDK -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <uses-feature
        android:glEsVersion="0x00020000"
        android:required="true" />

    <application
        android:name=".MotoHudApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.MotoHeadUnit">

        <!-- 高德 API Key：构建时由 local.properties 注入，空值在应用内引导填写 -->
        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="${AMAP_API_KEY}" />

        <!-- 高德定位服务（地图蓝点依赖） -->
        <service
            android:name="com.amap.api.location.APSService"
            android:exported="false" />

        <!-- 高德搜索无独立 Service，CoreService 为旧版（4.x）遗留，此处不再声明 -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 首次启动新手引导 -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 投屏导航 HUD（横屏大字体，屏幕常亮） -->
        <activity
            android:name=".ui.navi.HudActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 手机端专业导航页（地图 + 转向引导 + TTS 播报） -->
        <activity
            android:name=".ui.navi.GuidanceActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 二级页面容器（本地检索等低频功能） -->
        <activity
            android:name=".ui.HostActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.MotoHeadUnit" />

        <!-- 通知转发服务（复刻原 TWNotifyService：手机通知/来电 → 头盔） -->
        <service
            android:name=".service.NotificationForwardService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
