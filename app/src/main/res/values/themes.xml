<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 基础主题：tvOS 暗色玻璃风（参考 aerial-tv 设计语言） -->
    <style name="Theme.MotoHeadUnit" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg_window</item>
        <item name="android:colorBackground">@color/bg_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg_window</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/text_on_accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_stroke</item>
        <item name="colorError">@color/red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:textColorHighlight">@color/accent_dim</item>
        <!-- 全局弹窗统一外观（圆角 + 描边），所有 MaterialAlertDialogBuilder 自动继承。
             注意：这里只能设 materialAlertDialogTheme（它是 ThemeOverlay 类型）；
             alertDialogTheme 要求完整 Dialog 主题，指过去会在 inflate
             m3_alert_dialog 时因缺少布局属性直接崩。 -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Moto.Dialog</item>
        <item name="android:colorBackgroundFloating">@color/surface_high</item>
        <!-- 转场动画 -->
        <item name="android:windowAnimationStyle">@style/Animation.MotoActivity</item>
    </style>

    <!-- ===================== 弹窗 ===================== -->

    <!--
      统一弹窗外观。
      Material3 的 AlertDialog 背景是一个 MaterialShapeDrawable，圆角与描边走
      shapeAppearanceOverlay + colorOutline，比塞一个 android:background 可靠
      （后者会被 builder 内部重设，导致"有的弹窗有边框、有的没有"）。
    -->
    <style name="ThemeOverlay.Moto.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <!--
          这里必须是完全不透明的 dialog_surface。
          原先是 surface_high(#F21C1C1E)，那是配纯黑窗口的玻璃卡片色，
          一旦弹窗浮在地图/图片上，背景就会透出来（设置弹窗能看见摩托车）。
          主题层统一兜底，任何没走 MotoDialog.builder 的弹窗也不会再透。
        -->
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/card_stroke</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Moto.Dialog</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Moto.Dialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Moto.Dialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Moto.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Moto.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Moto.Dialog.Button</item>
    </style>

    <style name="ShapeAppearance.Moto.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <!--
      坑：m3_alert_dialog_title.xml 里的标题 View 是这样写的——
        <androidx.appcompat.widget.DialogTitle android:id="@+id/alertTitle"
            style="?attr/materialAlertDialogTitleTextStyle"/>
      它自身没有任何 android:layout_width/height，宽高完全由这个样式提供。
      所以 parent 必须是 MaterialAlertDialog.*.Title.Text 系列（它的祖先
      Base.MaterialAlertDialog.MaterialComponents.Title.Text 里写了
      layout_width=match_parent / layout_height=wrap_content）。
      如果 parent 换成纯 TextAppearance.*，layout 属性就丢了，
      父 LinearLayout 建 LayoutParams 时直接抛
      UnsupportedOperationException: You must supply a layout_width attribute，
      表现为「点管理地址必闪退」。
      这里显式再写一次宽高，双保险，避免以后换 parent 又踩回去。
    -->
    <style name="TextAppearance.Moto.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">start|center_vertical</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Moto.Dialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Widget.Moto.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- Activity 转场（干脆的入场滑屏） -->
    <style name="Animation.MotoActivity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <!-- 对话框动画 -->
    <style name="Theme.MotoDialog" parent="Theme.MotoHeadUnit">
        <item name="android:windowAnimationStyle">@style/Animation.MotoDialog</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">82%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>

    <style name="Animation.MotoDialog" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

    <!-- 文本样式 -->
    <style name="TextAppearance.Moto.Display" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Moto.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Moto.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Moto.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Moto.Callout" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TextAppearance.Moto.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- 组件样式 -->

    <!-- 玻璃卡片 -->
    <style name="Widget.Moto.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- 主按钮（橙色） -->
    <style name="Widget.Moto.Button.Accent" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_accent</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="rippleColor">@color/accent_dim</item>
        <item name="backgroundTint">@null</item>
        <!--
          这里原本有一条 android:layout_marginTop=8dp。
          样式里的 layout_* 会被解析成按钮自身的外边距，导致同一行里
          「投屏到车机」比「停止导航」低 8dp —— 就是那个"没有水平对齐"。
          布局属性一律写在 layout 里，样式只描述外观。
        -->
    </style>

    <!-- 幽灵按钮（描边） -->
    <style name="Widget.Moto.Button.Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="strokeColor">@color/fill_strong</item>
    </style>

    <!-- 危险按钮 -->
    <style name="Widget.Moto.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="backgroundTint">@null</item>
    </style>

    <!-- 输入框（搜索栏） -->
    <style name="Widget.Moto.SearchBar" parent="">
        <item name="android:background">@drawable/bg_search_bar</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- 区块标题 -->
    <style name="Widget.Moto.SectionHeader" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <!-- 保留旧样式引用（仪表卡片，逐步迁移） -->
    <style name="TelemetryCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">12dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
    </style>

    <style name="TelemetryLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="TelemetryValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/inter</item>
    </style>
</resources>
